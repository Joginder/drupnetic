{# SDC (Single Directory Component) Hero Component #}
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__content">
    <h1 id="hero-title" class="hero__title">
      Hello I’m <span class="highlight">{{ name }}</span>. <br>
      <span class="highlight">{{ role }}</span> Based in <span class="highlight">{{ location }}</span>.
    </h1>

    <p class="hero__desc">{{ description }}</p>

    <div class="hero__social">
      {% for item in social %}
        <a href="{{ item.url }}" class="hero__icon" aria-label="{{ item.label }}">
          <i class="{{ item.icon }}" aria-hidden="true"></i>
        </a>
      {% endfor %}
    </div>

    <a href="{{ resume_url }}" class="hero__btn">{{ 'Resume'|t }}</a>
  </div>

  <figure class="hero__image">
    <img src="{{ image }}" alt="{{ name }} illustration" />
  </figure>
</section>

